<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="res_patient_from_view" model="ir.ui.view">
        <field name="name">patient.from.view</field>
        <field name="model">res.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_patient_appointment" string="Appointment" type="object"/>
                    <button name="action_calculate_age" string="Calculate Age" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="patient_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="blood_group"/>
                            <field name="age"/>
                            <field name="date_of_birth"/>
                            <field name="previous_diseases"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_patient_list_view" model="ir.ui.view">
        <field name="name">patient.list.view</field>
        <field name="model">res.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_code"/>
                <field name="name"/>
                <field name="blood_group"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="mobile"/>
            </list>
        </field>
    </record>

    <record id="action_res_patient" model="ir.actions.act_window">
        <field name="name">Patient Detail</field>
        <field name="res_model">res.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="res_patient_main_menu_id" name="Bista HMS"/>
    <menuitem id="res_patient_detail_menu_id" name="Patient Details" parent="res_patient_main_menu_id"
              action="action_res_patient"/>
</odoo>