<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="stock_picking_inherited_view" model="ir.ui.view">
        <field name="name">stock.picking.inherited.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
           <xpath expr="/form/sheet/group/group//field[@name='picking_type_id']" position="after">
                <field name="lead_reference"/>
           </xpath>
        </field>
    </record>
</odoo>