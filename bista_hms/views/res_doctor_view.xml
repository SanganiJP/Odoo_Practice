<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_doctor_form_view" model="ir.ui.view">
        <field name="name">Doctor.Details.form.View</field>
        <field name="model">res.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="doctor_specialization"/>
                            <field name="hospital_id"/>
                        </group>
                        <group>
                            <field name="license_no"/>
                            <field name="experience_years"/>
                            <field name="is_emergency_available"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_doctor_list_view" model="ir.ui.view">
        <field name="name">Doctor.Details.List.View</field>
        <field name="model">res.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_specialization"/>
                <field name="license_no"/>
                <field name="experience_years"/>
                <field name="hospital_id"/>
                <field name="is_emergency_available"/>
            </list>
        </field>
    </record>

    <record id="res_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="res_doctor_menu_id" name="Doctor" parent="res_patient_main_menu_id" action="res_doctor_action"/>
</odoo>