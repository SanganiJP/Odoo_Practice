<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="note"/>
            </field>
        </field>
    </record>
    <record id="sale_order_line_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.line.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='price_unit']" position="after">
                <field name="previous_price"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_discount_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.discount.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/group[@name='note_group']" position="before">
                <group name="extra_discount">
                    <field name="discount_amount"/>
                    <field name="total_amount" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="lead_sale_order_inherited_view" model="ir.ui.view">
        <field name="name">lead.sale.order.line.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
           <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="lead_reference"/>
           </xpath>
        </field>
    </record>
</odoo>

