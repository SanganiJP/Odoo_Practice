<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="extra_note"/>
            </field>
        </field>
    </record>

    <record id="sale_order_line_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.line.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='price_unit']" position="after">
                <field name="previous_price"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_discount_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.discount.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/group[@name='note_group']" position="before">
                <group name="extra_discount">
                    <field name="discount_amount"/>
                    <field name="total_amount" readonly="1"/>
                    <field name="total_amount_in_word"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sale_order_available_qty_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.available.qty.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='price_unit']" position="before">
                <field name="available_qty"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='available_qty']" position="after">
                <field name="wh_location" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='wh_location']" position="after">
                <field name="available_qty_wh_loc"/>
            </xpath>
        </field>
    </record>

    <record id="lead_sale_order_inherited_view" model="ir.ui.view">
        <field name="name">lead.sale.order.line.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="lead_reference"/>
            </xpath>
        </field>
    </record>

</odoo>


