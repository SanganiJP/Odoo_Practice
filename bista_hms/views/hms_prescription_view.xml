<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="hms_prescription_from_view" model="ir.ui.view">
        <field name="name">hms.prescription.form.view</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_create_prescription_invoice" string="Create Invoice" type="object" invisible="state != 'confirm'"
                            class="btn-primary"/>
                    <button name="action_prescription_line" string="Prescription Detail" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prescription_delivery" type="object" invisible="state != 'confirm'"
                                class="oe_stat_button" icon="fa-truck" string="Delivery">
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="prescription_code" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Prescription Details">
                        <group>
                            <field name="patient_id"/>
                            <field name="prescription_date"/>
                            <field name="lead_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription">
                            <field name="prescription_lines">
                                <list>
                                    <field name="product_id"/>
                                    <field name="quantity" sum="total quantity"/>
                                    <field name="price_unit"/>
                                    <field name="total_amount" sum="Total amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hms_prescription_list_view" model="ir.ui.view">
        <field name="name">hms.prescription.list.view</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <list>
                <field name="prescription_code"/>
                <field name="patient_id"/>
                <field name="prescription_date"/>
            </list>
        </field>
    </record>

    <record id="action_hms_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">hms.prescription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hms_prescription_menu_id" name="Prescription" parent="res_patient_main_menu_id"
              action="action_hms_prescription"/>
</odoo>
