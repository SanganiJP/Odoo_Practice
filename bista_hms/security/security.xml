<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="group_appointment_user" model="res.groups">
        <field name="name">Appointment User</field>
    </record>

    <record id="group_appointment_admin" model="res.groups">
        <field name="name">Appointment Admin</field>
    </record>

    <record id="group_appointment_readonly_user" model="res.groups">
        <field name="name">Appointment Readonly User</field>
    </record>

    <record id="appointment_readonly_rule" model="ir.rule">
        <field name="name">Appointment Rule</field>
        <field name="model_id" ref="model_hms_appointment"/>
        <field name="domain_force">[( 1 , '=', 1 )]</field>
        <field name="groups" eval="[(4, ref('bista_hms.group_appointment_readonly_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

     <record id="prescription_readonly_rule" model="ir.rule">
        <field name="name">Prescription Rule</field>
        <field name="model_id" ref="model_hms_prescription"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bista_hms.group_appointment_readonly_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
