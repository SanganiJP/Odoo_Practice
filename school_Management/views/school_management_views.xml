<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="view_student_list" model="ir.ui.view">
            <field name="name">School.list</field>
            <field name="model">school.details</field>
            <field name="arch" type="xml">
                <list string="Students">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_student" model="ir.actions.act_window">
            <field name="name">School Details</field>
            <field name="res_model">school.details</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_student_list"/>
        </record>

        <menuitem id="student_main_menu_id" name="School"/>
        <menuitem id="student_detail_menu_id" name="School details" parent="student_main_menu_id" action="action_student"/>
    </data>
</odoo>
