<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="add_product_wizard_form" model="ir.ui.view">
        <field name="name">add.product.wizard.form</field>
        <field name="model">add.product.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="add_product_to_sale_order" string="Add" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="open_add_product_wizard_action" model="ir.actions.act_window">
        <field name="name">wizard_add_product_form_view</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">add.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list</field>
        <field name="target">new</field>
    </record>
</odoo>
