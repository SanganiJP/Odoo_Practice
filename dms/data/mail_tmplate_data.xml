<?xml version="1.0" ?>
<odoo noupdate="1">
    <!--Email template -->
    <record id="email_template_for_get_documents" model="mail.template">
        <field name="name">Get Document mail</field>
        <field name="model_id" ref="dms.model_sale_order"/>
<!--        <field name="email_from">{{object.user_id.login}}</field>-->
        <field name="email_from">{{object.env.user.email}}</field>
        <field name="email_to">{{object.user_id.login}}</field>
        <field name="auto_delete" eval="True"/>
        <field name="subject">Documents</field>
        <field name="description">Documents confirmation</field>
        <field name="body_html" type="html">
            <p>Hello,
                <strong>
                     <t t-out="object.env.user.name"/>
                </strong>
            </p>

            <br></br>
            <p>Get document operation performed by <t t-out="object.user_id.name"/> on sale order <t t-out="object.name"/></p>
            <br></br>

            <br></br>
            <p>Thank you</p>
            <p>Best regards,</p>
            <p>
                <t t-out="object.env.user.name"/>
            </p>
        </field>
    </record>
</odoo>
