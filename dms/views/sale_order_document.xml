<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_documents_list_view" model="ir.ui.view">
        <field name="name">documents.custom.list.view</field>
        <field name="model">sale.order.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="sale_order_id"/>
                <field name="document_id"/>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="sale_order_document_search_view" model="ir.ui.view">
        <field name="name">sale.order.document</field>
        <field name="model">sale.order.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="sale_order_id"/>
                <field name="document_id"/>
                <group expand="1" string="Group By">
                    <filter string="Document Name" name="document_id" context="{'group_by':'document_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_order_documents_view" model="ir.actions.act_window">
        <field name="name">Line Documents</field>
        <field name="res_model">sale.order.document</field>
        <field name="view_mode">list</field>
    </record>

    <!--    action_sale_order_documents_view-->
    <menuitem id="sale_order_documents_menu_id" name="Sale Order Line Documents" parent="doc_custom_main_menu_id"
              action="action_sale_order_documents_view"/>
</odoo>