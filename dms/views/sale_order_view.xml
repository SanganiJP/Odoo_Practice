<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="inherited_sale_order_view" model="ir.ui.view">
        <field name="name">inherited.sale.order.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="customer_tag_ids" widget="many2many_tags"/>
            </xpath>
             <xpath expr="//field[@name='customer_tag_ids']" position="after">
                <field name="document_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after" >
                 <button name="get_document_tags" string="Get Documents" type="object" class="btn-primary"/>
            </xpath>

        </field>
    </record>
</odoo>












