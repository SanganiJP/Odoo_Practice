<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="documents_custom_tag_form_view" model="ir.ui.view">
        <field name="name">documents.custom.tag.form.view</field>
        <field name="model">documents.tag.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_custom_tag_list_view" model="ir.ui.view">
        <field name="name">documents.custom.tag.list.view</field>
        <field name="model">documents.tag.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_doc_custom_tag_view" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">documents.tag.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="doc_custom_tag_menu_id" name="Tags" parent="doc_custom_main_menu_id"
              action="action_doc_custom_tag_view"/>
</odoo>