<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="documents_custom_form_view" model="ir.ui.view">
        <field name="name">documents.custom.form.view</field>
        <field name="model">documents.custom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="attachment_id"/>
                        <field name="tag_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_custom_list_view" model="ir.ui.view">
        <field name="name">documents.custom.list.view</field>
        <field name="model">documents.custom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="attachment_id"/>
                <field name="tag_ids"/>
            </list>
        </field>
    </record>

    <record id="action_doc_custom_form" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">documents.custom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="doc_custom_form_menu_id" name="Tags" parent="doc_custom_main_menu_id"
              action="action_doc_custom_form"/>
</odoo>