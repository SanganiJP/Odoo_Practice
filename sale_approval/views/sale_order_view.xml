<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                 <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,sent,sale"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                 <button name="button_approve" string="Approve Order" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>

