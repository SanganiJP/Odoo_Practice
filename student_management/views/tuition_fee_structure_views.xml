<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="tuition_fee_structure_form_view" model="ir.ui.view">
        <field name="name">tuition.fee.structure.form.view</field>
        <field name="model">tuition.fee.structure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Course Detail">
                        <field name="standard"/>
                        <field name="course_name"/>
                        <field name="course_fee_amount"/>
                        <field name="quantity"/>
                        <field name="course_fees"/>
                        <field name="discount"/>
                        <field name="total"/>
                        <!--                        <field name="tuition_free_structure"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tuition_fee_structure_list_view" model="ir.ui.view">
        <field name="name">tuition.fee.structure.list.view</field>
        <field name="model">tuition.fee.structure</field>
        <field name="arch" type="xml">
            <list>
                <field name="standard"/>
                <field name="course_name"/>
                <field name="course_fee_amount" readonly="1"/>
                <field name="quantity"/>
                <field name="course_fees"/>
                <field name="discount"/>
                <field name="total"/>
                <!--                <field name="tuition_free_structure"/>-->
            </list>
        </field>
    </record>

    <record id="action_tuition_fee_structure" model="ir.actions.act_window">
        <field name="name">Tuition fee structure</field>
        <field name="res_model">tuition.fee.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menu categories -->
    <menuitem name="Tuition fee structure" id="res_tuition_fee_structure_menu_id" parent="student_management_menu_id"
              action="action_tuition_fee_structure"/>
</odoo>