<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="subject_subject_list_view" model="ir.ui.view">
        <field name="name">subject.subject.list.view</field>
        <field name="model">subject.subject</field>
        <field name="arch" type="xml">
            <list editable="bottom">
<!--                 editable="Bottom"-->
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_res_subject" model="ir.actions.act_window">
        <field name="name">subject subject</field>
        <field name="res_model">subject.subject</field>
        <field name="view_mode">list</field>
    </record>

    <!-- menu categories -->
    <menuitem name="Subject" id="res_subject_menu_id" parent="student_management_menu_id" action="action_res_subject"/>
</odoo>