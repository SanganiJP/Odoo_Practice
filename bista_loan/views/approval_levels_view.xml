<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_levels_form_view" model="ir.ui.view">
        <field name="name">approval.levels.form</field>
        <field name="model">approval.levels</field>
        <field name="arch" type="xml">
            <form string="Teams">
                <sheet>
                    <group>
                        <group>
                            <field name="team_level"/>
                            <field name="name"/>
                            <field name="team_id"/>
                            <field name="team_member" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_levels_list_view" model="ir.ui.view">
        <field name="name">approval.levels.list</field>
        <field name="model">approval.levels</field>
        <field name="arch" type="xml">
            <list string="Level">
                <field name="team_level"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="team_member" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="approval_level_act_window" model="ir.actions.act_window">
        <field name="name">Approval Level</field>
        <field name="res_model">approval.levels</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Approval Levels" id="approval_level_menu" parent="configuration_menu"
              action="approval_level_act_window"/>
</odoo>