<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="loan_system_form_view" model="ir.ui.view">
            <field name="name">loan_system_form</field>
            <field name="model">loan.system</field>
            <field name="arch" type="xml">
                <form string="Loan Application Form">
                    <header>
                        <button name="generate_emi_lines"
                                type="object"
                                class="btn-primary"
                                string="Get EMI Information"
                        />

                        <button name="action_confirm"
                                type="object"
                                invisible="loan_stage != 'draft'"
                                class="btn-primary"
                                string="Confirm"
                        />

                        <button name="action_approve"
                                type="object"
                                class="btn-primary"
                                invisible="loan_stage != 'to_approve' or current_user not in next_approver"
                                string="Approve"
                        />

                        <button name="action_reject"
                                type="object"
                                class="btn-primary"
                                invisible="loan_stage != 'to_approve' or current_user not in next_approver"
                                string="Reject"
                        />

                        <field name="loan_stage"
                               widget="statusbar"
                               statusbar_visible="draft,to_approve"
                        />

                    </header>

                    <sheet>
                        <widget name="web_ribbon" title="Approved" invisible="loan_stage != 'approved'"/>
                        <div class="oe_button_box" name="button_box">
<!--                            <button name="action_view_invoice"-->
<!--                                    type="object"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-pencil-square-o"-->
<!--                                    invisible="loan_stage != 'approved'">-->
<!--                                <field name="invoice_count" widget="statinfo" string="Invoice"/>-->
<!--                            </button>-->
                            <button name="action_view_invoice"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o">
                                <field name="invoice_count" widget="statinfo" string="Invoice"/>
                            </button>
                            <button name="action_view_advance_payment_bill"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o">
                                <field name="advance_payment_count" widget="statinfo" string="Payment Bills"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>

                            <group string="Customer Information">
                                <field name="partner_id" required="1"/>
                                <field name="assign_user_ids" widget="many2many_tags"/>
                                <field name="team_id" required="1"/>
                                <field name="next_approver" widget="many2many_tags" readonly="1"/>
                            </group>

                            <group string="Loan Duration">
                                <field name="is_payment_done"/>
                                <field name="start_date"/>
                                <field name="end_date" readonly="1" force_save="1"/>
                            </group>

                            <group string="Loan Amount Details">
                                <field name="loan_amount" required="1"/>
                                <field name="period_tenure" required="1"/>
                                <field name="total_interest_amount"/>
                                <field name="total_principle_amount"/>
                                <field name="paid_principle_amount"/>
                                <field name="pending_principle_amount"/>
                            </group>

                            <group string="EMI Information">
                                <field name="emi_amount"/>
                                <field name="emi_date" required="1"/>
                                <field name="next_emi_date" readonly="1"/>
                                <field name="current_interest_rate" readonly="1"/>
                                <field name="paid_interest_amount"/>
                                <field name="pending_interest_amount"/>
                                <field name="current_user" readonly="1"/>
                            </group>

                        </group>

                        <notebook>

                            <page string="Interest Rate">

                                <field name="interest_rate_ids">
                                    <list editable="bottom" decoration-success="is_active == True">
                                        <field name="date"/>
                                        <field name="interest_rate"/>
                                        <field name="is_active" column_invisible="1"/>
                                        <button name="activate_interest_rate"
                                                type="object"
                                                class="btn-primary"
                                                string="Activate"
                                                invisible="is_active or date &lt; datetime.date.today().strftime('%Y-%m-%d')"
                                                confirm="Are you sure you want to apply this interest rate?"
                                        />
                                    </list>
                                </field>

                            </page>

                            <page string="EMI Schedule">

                                <field name="emi_line_ids">
                                    <list editable="bottom" decoration-danger="state == 'invoiced'"
                                          decoration-success="state == 'paid'">
                                        <field name="emi_date"/>
                                        <field name="principal_amount"/>
                                        <field name="interest_charged"/>
                                        <field name="total_payment"/>
                                        <field name="balance"/>
                                        <field name="state"/>
                                    </list>
                                </field>

                            </page>

                            <page string="Approval Workflow">

                                <field name="loan_approval_level_ids" readonly="1" force_save="1">
                                    <list>
                                        <field name="team_level"/>
                                        <field name="name"/>
                                        <field name="loan_id" column_invisible="1"/>
                                        <field name="team_member" widget="many2many_tags"/>
                                        <field name="loan_approve_stage"/>
                                        <field name="approved_by"/>
                                        <field name="rejected_by"/>
                                        <field name="approve_time"/>
                                    </list>
                                </field>

                            </page>

                            <page string="Advance Payments">
                                <field name="advance_payments_ids">
                                    <list editable="bottom">
                                        <field name="payment_date"/>
                                        <field name="payment_amount"/>
                                        <field name="is_paid"/>
                                        <button name="process_advance_payment" type="object" string="Pay"
                                                class="btn-primary"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="loan_system_tree_view" model="ir.ui.view">
            <field name="name">loan_system_list</field>
            <field name="model">loan.system</field>
            <field name="arch" type="xml">
                <list string="Loan System">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="loan_amount"/>
                    <field name="period_tenure"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="loan_system_act_window" model="ir.actions.act_window">
            <field name="name">Loan System</field>
            <field name="res_model">loan.system</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item will appear in the Upper bar, That's why It needs NO parent or action -->
        <menuitem id="loan_system_root" name="Bista Loan System"/>
        <menuitem name="Loan System" id="loan_system_menu" parent="loan_system_root" action="loan_system_act_window"/>
    </data>
</odoo>