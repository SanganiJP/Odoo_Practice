<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="college_classroom_from_view" model="ir.ui.view">
        <field name="name">college.classroom.from.view</field>
        <field name="model">college.classroom</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_student_list_view" string="Student" type="object"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="teacher_id"/>
                        <field name="total_student"/>
                    </group>
                    <group>
                        <notebook>
                            <page string="Students">
                                <field name="student_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="dob"/>
                                        <field name="age"/>
                                        <field name="grade"/>
                                        <field name="phone"/>
                                        <field name="classroom_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="college_classroom_list_view" model="ir.ui.view">
        <field name="name">college.classroom.list.view</field>
        <field name="model">college.classroom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="total_student"/>
            </list>
        </field>
    </record>

    <record id="action_college_classroom" model="ir.actions.act_window">
        <field name="name">college classroom</field>
        <field name="res_model">college.classroom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Classroom" id="college_classroom_menu_id" parent="college_student_main_menu_id"
              action="action_college_classroom"/>
</odoo>