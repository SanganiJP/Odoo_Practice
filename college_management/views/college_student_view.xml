<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
        <record id="college_student_from_view" model="ir.ui.view">
        <field name="name">college.student.from.view</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="dob"/>
                        <field name="age"/>
                        <field name="grade"/>
                        <field name="phone"/>
                        <field name="classroom_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="college_student_list_view" model="ir.ui.view">
        <field name="name">college.student.list.view</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="grade"/>
                <field name="phone"/>
                <field name="classroom_id"/>
            </list>
        </field>
    </record>

    <record id="action_college_management" model="ir.actions.act_window">
        <field name="name">college student</field>
        <field name="res_model">college.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="college_student_main_menu_id" name="College Management"/>
    <menuitem name="Students" id="college_student_menu_id" parent="college_student_main_menu_id" action="action_college_management"/>
</odoo>