<?xml version="1.0"?>
<odoo>

    <record id="view_account_payment_form_inherit_payment" model="ir.ui.view">
        <field name="name">view.account.payment.form.inherit.payment</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="before">
                <field name="remaining_amount"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Invoices">
                    <field name="invoice_rec_ids" force_save="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="due_amount"/>
                            <field name="allocation_amount" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
