<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sale_rma_from_view" model="ir.ui.view">
        <field name="name">sale.rma.form.view</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sale_rma_return_wizard" class="btn-primary" type="object" string="Return"/>
                    <button name="action_sale_rma_invoice_wizard" class="btn-primary" type="object" string="Invoice"/>
                    <button name="action_sale_rma_add_product_wizard" class="btn-primary" type="object"
                            string="Add Product"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_receipt" type="object"
                                class="oe_stat_button" icon="fa-truck" string="Delivery">
                            <field name="delivery_count" widget="statinfo" string="Delivery"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="team_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_team_id"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="product_ids"/>
                            <field name="sale_order_id" options="{'no_create': True, 'no_create_edit':True}"
                                   context="{'partner_id': partner_id}"/>
                            <!--                            <field name="sale_order_id" domain="[('partner_id', '=', partner_id)]" options="{'no_create': True, 'no_create_edit':True}"/>-->
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="RMA Lines">
                                <field name="rma_line_ids" force_save="1">
                                    <list editable="bottom">
                                        <field name="product_id" domain="[('id', 'not in', parent.product_ids.ids)]"/>
                                        <field name="sale_order_qty"/>
                                        <field name="unit_price"/>
                                        <field name="available_qty"/>
                                        <field name="to_receive"/>
                                        <field name="received_qty"/>
                                        <field name="invoiced_qty"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_rma_list_view" model="ir.ui.view">
        <field name="name">sale.rma.list.view</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <list>
                <field name="team_id"/>
                <field name="sale_team_id"/>
                <field name="date"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="action_sale_rma_form" model="ir.actions.act_window">
        <field name="name">Sale RMA</field>
        <field name="res_model">sale.rma</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sale_rma_main_menu_id" name="RMA"/>
    <menuitem id="sale_rma_form_menu_id" name="Sale RMA" parent="rma.sale_rma_main_menu_id"
              action="rma.action_sale_rma_form"/>
</odoo>
