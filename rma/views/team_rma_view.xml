<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="team_rma_from_view" model="ir.ui.view">
        <field name="name">team.rma.form.view</field>
        <field name="model">team.rma</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <group>
                        <group>
                            <field name="team_name"/>
                            <field name="team_prefix"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="team_rma_list_view" model="ir.ui.view">
        <field name="name">team.rma.list.view</field>
        <field name="model">team.rma</field>
        <field name="arch" type="xml">
            <list>
                <field name="team_name"/>
                <field name="team_prefix"/>
            </list>
        </field>
    </record>

     <record id="action_sale_team_rma_form" model="ir.actions.act_window">
        <field name="name">Sales Team RMA</field>
        <field name="res_model">team.rma</field>
        <field name="view_mode">list,form</field>
         <field name="view_id" ref="team_rma_list_view"/>
    </record>

    <menuitem id="sale_team_rma_form_menu_id" name="Teams" parent="sale_rma_main_menu_id"
          action="action_sale_team_rma_form"/>
</odoo>