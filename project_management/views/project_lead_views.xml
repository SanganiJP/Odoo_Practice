<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="project_lead_form_view" model="ir.ui.view">
        <field name="name">Project_lead_form_view</field>
        <field name="model">lead.info</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_project_info_wizard" string="Open wizard" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page name="Lead Details">
                                <field name="lead_ids" >
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="project_type"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="name"/>
                                                <field name="project_type"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="User Details">
                                <field name="project_ids"/>
                                <field name="project_users"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_lead_list_view" model="ir.ui.view">
        <field name="name">Project_lead_list_view</field>
        <field name="model">lead.info</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="project_lead_action" model="ir.actions.act_window">
        <field name="name">Project Lead Information</field>
        <field name="res_model">lead.info</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_lead_menu_id" parent="project_main_menu_id" action="project_lead_action" name="Lead Information"/>
</odoo>
