<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="project_types_form_view" model="ir.ui.view">
        <field name="name"> Project type form view</field>
        <field name="model">project.types</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page name="Project Info">
                                <field name="project_types_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="project_lead_name"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="name"/>
                                                <field name="project_lead_name"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_types_list_view" model="ir.ui.view">
        <field name="name"> Project type list view</field>
        <field name="model">project.types</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">project.types</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_types_menu_id" parent="project_main_menu_id" action="action_project_type" name="Project Types"/>
</odoo>