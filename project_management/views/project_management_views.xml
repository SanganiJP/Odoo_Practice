<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="project_form_view" model="ir.ui.view">
        <field name="name">Project_detail_form</field>
        <field name="model">project.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <group>
                        <field name="name"/>
                        <field name="project_lead_name"/>
                        <field name="project_type"/>
                   </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_list_view" model="ir.ui.view">
        <field name="name">Project_detail_list</field>
        <field name="model">project.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_lead_name"/>
                <field name="project_type"/>
            </list>
        </field>
    </record>

    <record id="project_action_id" model="ir.actions.act_window">
        <field name="name">Project Detail</field>
        <field name="res_model">project.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_main_menu_id" name="Project Management"/>
    <menuitem id="project_detail_menu_id" name="Project Details" parent="project_main_menu_id" action="project_action_id"/>
</odoo>
