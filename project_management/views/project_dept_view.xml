<odoo>

    <record id="project_department_list_id">
        <field name="name">Project department list</field>
        <field name="model">project.dept</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="department_action_id" model="ir.actions.act_window">
        <field name="name">Project Department</field>
        <field name="res_model">project.dept</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_dept_menu_id" parent="project_main_menu_id" string="Department" action="department_action_id"/>
</odoo>