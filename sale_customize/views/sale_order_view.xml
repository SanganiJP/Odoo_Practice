<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field/list//field[@name='product_uom_qty']" position="after">
                <field name="location_id" domain="[('warehouse_id','=', parent.warehouse_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>



