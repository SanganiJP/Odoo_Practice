<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="add_product_wizard_form" model="ir.ui.view">
        <field name="name">add.product.wizard.form</field>
        <field name="model">add.product.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_ids"/>
                    </group>
                    <footer>
                        <button name="add_product_to_order_line" string="Add" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
