    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!--            <xpath expr="//sheet/group/group//field[@name='partner_id']" position="after">&ndash;&gt;-->
            <!--                <field name="warehouse_id" position="move"/>-->
            <!--            </xpath>-->
            <xpath expr="//button[@name='action_quotation_send']" position="after">

                <button name="button_approve" string="Approve Order" type="object" class="btn-primary"
                        invisible="state != 'to_approve'" groups="practical_jayesh.group_sale_approver"/>

                <button name="button_cancel" string="Cancel" type="object" class="btn-primary"
                        invisible="state != 'to_approve'"/>

            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="service_type_product_qty"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="inside">
                <button name="action_add_product_wizard" class="btn-primary" type="object"
                        string="Add Product"/>
            </xpath>
        </field>
    </record>

</odoo>












