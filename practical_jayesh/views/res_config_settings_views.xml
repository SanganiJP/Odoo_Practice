<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <field name="sale_approval" invisible="1"/>
                <setting id="sale_approval"
                         help="Request managers to approve orders above a minimum amounts"
                         groups="practical_jayesh.group_sale_approver">
                    <field name="sale_approval"/>
                    <div class="content-group" invisible="not sale_approval">
                        <div class="row mt16">
                            <label for="sale_min_amount" class="col-lg-4 o_light_label"/>
                            <field name="sale_min_amount"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
