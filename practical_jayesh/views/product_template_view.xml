<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="inherited_product_template_only_form_view" model="ir.ui.view">
        <field name="name">inherited.product.template.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='type']" position="after">
                <field name="pharma_product_id"/>
            </xpath>
        </field>
    </record>
</odoo>



