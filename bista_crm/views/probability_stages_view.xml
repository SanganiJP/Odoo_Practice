<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="probability_stage_form_view" model="ir.ui.view">
        <field name="name">probability.stages.list.view</field>
        <field name="model">probability.stages</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                         <group>
                            <field name="name"/>
                            <field name="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="probability_stage_list_view" model="ir.ui.view">
        <field name="name">probability.stages.list.view</field>
        <field name="model">probability.stages</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="percentage"/>
            </list>
        </field>
    </record>

    <record id="probability_stage_view" model="ir.actions.act_window">
        <field name="name">Probability stage</field>
        <field name="res_model">probability.stages</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="probability_stage" name="Probability stage" parent="crm.crm_menu_root"
              action="probability_stage_view"/>
</odoo>
