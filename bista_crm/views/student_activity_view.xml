<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="student_activity_list_view" model="ir.ui.view">
        <field name="name">student.activity.list.view</field>
        <field name="model">student.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="student_activity_view" model="ir.actions.act_window">
        <field name="name">Student Activity</field>
        <field name="res_model">student.activity</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="student_activity_menu_id" name="Student activity" parent="crm.crm_menu_root"
              action="student_activity_view"/>
</odoo>
