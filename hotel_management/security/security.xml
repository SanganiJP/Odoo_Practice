<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="group_loan_system_user" model="res.groups">
        <field name="name">Loan system User</field>
    </record>

    <record id="group_loan_system_manager" model="res.groups">
        <field name="name">Loan system manager</field>
    </record>

    <record id="group_loan_system_admin" model="res.groups">
        <field name="name">Loan system admin</field>
    </record>

    <record id="group_loan_system_user_rule" model="ir.rule">
        <field name="name">Loan System User Rule</field>
        <field name="model_id" ref="model_loan_system"/>
        <field name="domain_force">['|' ,('assign_user_ids', 'in', user.id) ,'|' ,('create_uid', '=', user.id) ,
            ('next_approver', 'in', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('bista_loan.group_loan_system_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="group_loan_system_manager_rule" model="ir.rule">
        <field name="name">Loan System Manager Rule</field>
        <field name="model_id" ref="model_loan_system"/>
        <field name="domain_force">[(1 ,'=', 1)]</field>
        <field name="groups" eval="[(4, ref('bista_loan.group_loan_system_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
