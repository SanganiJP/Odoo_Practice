<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <!--Form View-->
    <record id="hotel_booking_form_view" model="ir.ui.view">
        <field name="name">Hotel Booking Form View</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <form string="">
<!--                <header>-->
<!--                    <button name="" string="" type="object" />-->
<!--                </header>-->
                <sheet>
                    <!--smart button-->
<!--                    <div class="oe_button_box" name="button_box">-->
<!--                        <button type="object" name="action_open_appointments" class="oe_stat_button" icon="fa-solid fa-calendar">-->
<!--                                <field string="Appointments" name="appointment_count" widget="statinfo"/>-->
<!--                        </button>-->
<!--                    </div>-->
<!--                    Sequence code-->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Detail">
                            <field name="partner_id"/>
                            <field name="gender" widget="radio"/>
                            <field name="phone_no"/>
                            <field name="email"/>
                        </group>
                        <group string="Booking Dates">
                            <field name="total_duration"/>
                            <field name="check_in_date"/>
                            <field name="check_out_date"/>
                            <field name="booking_date"/>
                        </group>
                        <group string="Room details">
                            <field name="number_of_guests"/>
                            <field name="room_category"/>
                        </group>
<!--                        <notebook>-->
<!--                            <page string="">-->
<!--                                <field name="">-->
<!--                                    <list editable="bottom">-->
<!--                                        <field name=""/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->
<!--                        </notebook>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--List View-->
    <record id="hotel_booking_list_view" model="ir.ui.view">
        <field name="name">Hotel Booking List View</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="gender"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <!--Menu action-->
    <record id="hotel_booking_act_window" model="ir.actions.act_window">
        <field name="name">Hotel Booking</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menu Item-->
    <menuitem id="hotel_management_root_menu_id" name="Hotel Management" />
    <menuitem id="hotel_booking_menu_id" name="Room Booking" parent="hotel_management_root_menu_id" action="hotel_booking_act_window"/>

</odoo>