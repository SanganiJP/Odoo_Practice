<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <!--Form View-->
    <record id="hotel_booking_form_view" model="ir.ui.view">
        <field name="name">Hotel Booking Form View</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state == 'confirm'"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Detail">
                            <field name="guest_id"/>
                            <field name="phone_no"/>
                            <field name="email"/>
                        </group>
                        <group string="Booking Dates">
                            <field name="total_duration"/>
                            <field name="check_in_date"/>
                            <field name="check_out_date" force_save="1"/>
                            <field name="booking_date" invisible="1"/>
                        </group>
                        <group string="Room details">
                            <field name="number_of_guests"/>
                            <field name="number_of_rooms"/>
                            <field name="category_id" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name="room_ids" widget="many2many_tags"
                                   domain="[('category_id', '=', category_id), ('is_available', '=', True)]"/>
                        </group>
                        <group string="Payment Details">
                            <field name="price" force_save="1"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--List View-->
    <record id="hotel_booking_list_view" model="ir.ui.view">
        <field name="name">Hotel Booking List View</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="phone_no"/>
                <field name="check_in_date"/>
                <field name="check_out_date"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!--Menu action-->
    <record id="hotel_booking_act_window" model="ir.actions.act_window">
        <field name="name">Hotel Booking</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menu Item-->
    <menuitem id="hotel_management_root_menu_id" name="Hotel Management"/>
    <menuitem id="hotel_booking_menu_id" name="Hotel Reservation" parent="hotel_management_root_menu_id"
              action="hotel_booking_act_window"/>

</odoo>