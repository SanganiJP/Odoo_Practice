<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <!--Form View-->
    <record id="hotel_room_form_view" model="ir.ui.view">
        <field name="name">Hotel Room Form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Rooms">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,reserved"/>
                </header>
                <sheet>
                    <!--smart button-->
                    <!--                    <div class="oe_button_box" name="button_box">-->
                    <!--                        <button type="object" name="action_open_appointments" class="oe_stat_button" icon="fa-solid fa-calendar">-->
                    <!--                                <field string="Appointments" name="appointment_count" widget="statinfo"/>-->
                    <!--                        </button>-->
                    <!--                    </div>-->
                    <!--Sequence code-->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Rooms Detail">
                            <field name="is_available" readonly="1"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bookings">
                            <field name="booking_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--List View-->
    <record id="hotel_room_list_view" model="ir.ui.view">
        <field name="name">Hotel Room List</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="is_available"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <!--Menu action-->
    <record id="hotel_room_act_window" model="ir.actions.act_window">
        <field name="name">Room</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menu Item-->
    <menuitem id="hotel_room_menu_id" name="Rooms" parent="hotel_management_root_menu_id"
              action="hotel_room_act_window"/>

</odoo>