<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="_from_view" model="ir.ui.view">
        <field name="name">.form.view</field>
        <field name="model"></field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_create_prescription_invoice" string="Create Invoice" type="object"
                            invisible="state != 'confirm'"
                            class="btn-primary"/>
                    <button name="action_create_prescription_delivery" string="Create Delivery" type="object"
                            class="btn-primary"/>
                    <button name="action_prescription_line" string="Prescription Detail" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prescription_delivery" type="object"
                                class="oe_stat_button" icon="fa-truck" string="Delivery">
                            <field name="delivery_count" widget="statinfo" string="Delivery"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="prescription_code" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Prescription Details">
                        <group>
                            <field name="patient_id" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name="prescription_date"/>
                            <field name="lead_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription">
                            <field name="prescription_lines">
                                <list>
                                    <field name="product_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                    <field name=""/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="_list_view" model="ir.ui.view">
        <field name="name">.list.view</field>
        <field name="model"> </field>
        <field name="arch" type="xml">
            <list>
                <field name=""/>
                <field name=""/>
                <field name=""/>
            </list>
        </field>
    </record>

    <record id="model_action" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model"> </field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="main_menu_id" name=""/>
    <menuitem id="hms_prescription_menu_id" name="" parent="main_menu_id"
              action="model_action"/>
</odoo>
