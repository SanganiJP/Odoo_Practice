<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="inherited_sale_order_view" model="ir.ui.view">
        <field name="name">inherited.sale.order.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="customer_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="doc_count"/>
            </xpath>
             <xpath expr="//field[@name='customer_tag_ids']" position="after">
                <field name="document_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after" >
                 <button name="get_document_tags" string="Get Documents" type="object" class="btn-primary"/>
            </xpath>
            <xpath expr="//button[@name='get_document_tags']" position="after" >
                 <button name="%(open_add_product_wizard_action)d" string="Add Products" type="action" class="btn-primary"/>
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Documents" >
                    <field name="document_line_ids">
                        <list>
<!--                            <field name="name"/>-->
                            <field name="document_id"/>
                            <field name="product_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="sale_order_view_search_inherit_view" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="client_order_ref"/>
            </xpath>
        </field>
    </record>

