<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="product_detail_form_view" model="ir.ui.view">
        <field name="name">product.details.list.view</field>
        <field name="model">product.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="order_line_ids" readonly="1" force_save="1">
                                <list>
                                    <field name="name"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_detail_list_view" model="ir.ui.view">
        <field name="name">product.detail.list.view</field>
        <field name="model">product.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="product_detail_view" model="ir.actions.act_window">
        <field name="name">Product details</field>
        <field name="res_model">product.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="product_detail_main_menu_id" name="Example"/>
    <menuitem id="product_detail_menu_id" name="Product detail" parent="product_detail_main_menu_id"
              action="product_detail_view"/>
</odoo>


