<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="mrp_production_form_view_inherited" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherited</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_confirm']" position="after">
                <button name="action_assign_serial_wizard" class="btn-primary" type="object" string="Assign Serial No"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="lot_ids" widget="many2many_tags" readonly="1"
                       options="{'no_create': True, 'no_create_edit':True}"/>
                <!--                <field name="lot_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>-->
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']" position="attributes">-->
                <attribute name="domain">[('id','=',lot_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>