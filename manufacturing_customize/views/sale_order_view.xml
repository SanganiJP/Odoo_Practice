<odoo>
    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="process_all" string="Process All" type="object" class="btn-primary"/>
            </xpath>
             <xpath expr="//page[@name='order_lines']/field/list//field[@name='product_uom_qty']" position="after">
                <field name="process_qty"/>
            </xpath>
        </field>
    </record>
</odoo>