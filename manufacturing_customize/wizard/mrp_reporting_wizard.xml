<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="open_mrp_report_wizard_form" model="ir.ui.view">
        <field name="name">mrp.reporting.wizard.form</field>
        <field name="model">mrp.reporting.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <footer>
                        <button name="download_report" string="Download" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="open_mrp_report_wizard" model="ir.actions.act_window">
        <field name="name">Mrp Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.reporting.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="open_mrp_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mrp_report" name="Report" parent="mrp.menu_mrp_reporting" action="open_mrp_report_wizard"/>
</odoo>